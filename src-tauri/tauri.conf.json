{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM Hub",
  "version": "0.1.0",
  "identifier": "com.pmhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PM Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server-dist/server.cjs": "server/server.cjs"
    },
    "shortDescription": "AI統合型タスク管理",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  }
}
